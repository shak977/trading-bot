# Copy to .env and fill in. Use PAPER keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
# true = paper trading (safe). Set to false ONLY with live keys and at your own risk.
ALPACA_PAPER=true
# Optional: AI analyst notes. Leave blank to disable. Key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-4-5)
LLM_MODEL=
# Optional: live-price proxy (Cloudflare Worker URL). See LIVE_SETUP.md. Blank = off.
LIVE_QUOTES_URL=
# Optional research feeds (free keys; blank = that section is skipped)
FINNHUB_API_KEY=
FRED_API_KEY=
